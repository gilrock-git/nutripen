{
  "name": "nutripen-loja",
  "version": "1.0.0",
  "private": true,
  "description": "NutriPen — versão Android (Google Play) via Capacitor",
  "scripts": {
    "build:web": "python3 scripts/build_store.py",
    "sync": "npm run build:web && cap sync android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor '#0d9488' --iconBackgroundColorDark '#0d9488' --splashBackgroundColor '#f8fafc' --splashBackgroundColorDark '#020617'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "lucide": "0.460.0",
    "playwright": "1.63.0",
    "tailwindcss": "3.4.16"
  }
}
